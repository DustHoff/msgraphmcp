# Required
AZURE_CLIENT_ID=your-app-registration-client-id
AZURE_TENANT_ID=your-tenant-id

# Optional – used when the app registration is a confidential client
AZURE_CLIENT_SECRET=your-client-secret

# Scopes requested during device code flow (space-separated)
# Default includes all scopes including Intune. Override to restrict:
# GRAPH_SCOPES=User.Read Mail.ReadWrite Mail.Send Calendars.ReadWrite Files.ReadWrite.All \
#   Group.ReadWrite.All Team.ReadWrite.All Channel.ReadWrite.All \
#   Sites.ReadWrite.All Tasks.ReadWrite Contacts.ReadWrite \
#   DeviceManagementApps.ReadWrite.All \
#   DeviceManagementConfiguration.ReadWrite.All \
#   DeviceManagementManagedDevices.ReadWrite.All \
#   DeviceManagementServiceConfig.ReadWrite.All \
#   Directory.ReadWrite.All offline_access

# Path inside the container where the MSAL token cache is stored
# TOKEN_CACHE_PATH=/data/tokens.json

# ── HTTP / Kubernetes mode (set PORT to enable) ───────────────────────────────
# PORT=8080

# Authorization-code (delegated, per-user) is the ONLY auth mode allowed over HTTP.
# Set AZURE_REDIRECT_URI together with AZURE_CLIENT_SECRET (above) to enable it:
# AZURE_REDIRECT_URI=https://<your-host>/auth/callback

# Inbound auth gate: bearer token the MCP client (Claude Code) must send on every
# /mcp request. The server refuses to start in HTTP mode without it.
# Generate with: openssl rand -hex 32
# MCP_AUTH_TOKEN=replace-with-a-high-entropy-secret

# Escape hatches for trusted, NON-public networks only (the server fails closed
# without them in HTTP mode):
# MCP_ALLOW_INSECURE_AUTH_MODE=true   # permit app-only / device-code over HTTP (audit AUTH-1/AUTH-4)
# MCP_ALLOW_UNAUTHENTICATED=true      # run /mcp without the MCP_AUTH_TOKEN gate (audit CSRF-1)

# Logging: GRAPH_DEBUG defaults ON and logs full Graph request/response bodies.
# Set to false in production (audit LOG-1/LOG-2).
# GRAPH_DEBUG=false
# LOG_LEVEL=warn

# Per-IP rate limiting on HTTP endpoints (audit DOS-1). Set RATE_LIMIT_MAX=0 to disable.
# RATE_LIMIT_MAX=600
# RATE_LIMIT_WINDOW_SEC=60
# Enable only behind a trusted proxy/ingress that sets X-Forwarded-For:
# TRUST_PROXY=true
